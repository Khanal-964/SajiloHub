# ============================================
# SajiloHub Server — Environment Variables
# ============================================

# Server
PORT=5000

# MySQL Database
# ⚠️  IMPORTANT: Replace 'your_mysql_password_here' with your actual MySQL root password!
#     Leaving this blank or wrong causes: ER_ACCESS_DENIED_ERROR
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sajilohub

# JWT (CHANGE THIS to a strong random string in production!)
JWT_SECRET=sajilohub_dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=659802388157-2vbhunb5ffoj3sjn2hahehebvqktd132.apps.googleusercontent.com

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Cloud Translation API (Get from https://console.cloud.google.com)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
